// Single source of truth for YAML and ROS parameters. Distances: m; angles: rad.
AIM_PARAMETER(std::string, scene_path, "../scenes/lab.xml")
AIM_PARAMETER(std::string, initial_mode, "manual")
AIM_PARAMETER(bool, camera_enabled, true)
AIM_PARAMETER(int, camera_width, 640)
AIM_PARAMETER(int, camera_height, 480)
AIM_PARAMETER(double, camera_fps, 120.0)
AIM_PARAMETER(double, camera_fovy_deg, 60.0)
AIM_PARAMETER(int, camera_msaa, 0)
AIM_PARAMETER(bool, camera_shader, true)
AIM_PARAMETER(double, camera_exposure, 1.0)
AIM_PARAMETER(double, camera_bloom, 0.55)
AIM_PARAMETER(double, camera_lamp_intensity, 4.0)
AIM_PARAMETER(bool, camera_shadows, false)
AIM_PARAMETER(double, state_hz, 150.0)
AIM_PARAMETER(double, physics_timestep, 0.0005)
AIM_PARAMETER(double, manual_translation_speed, 2.0)
AIM_PARAMETER(double, manual_angular_speed, 1.5)
AIM_PARAMETER(double, mouse_sensitivity, 0.003)
AIM_PARAMETER(double, yaw_min, -3.141592653589793)
AIM_PARAMETER(double, yaw_max, 3.141592653589793)
AIM_PARAMETER(double, pitch_min, -0.523598775598299)
AIM_PARAMETER(double, pitch_max, 0.785398163397448)
AIM_PARAMETER(double, servo_max_speed, 8.0)
AIM_PARAMETER(double, base_x_min, -12.0)
AIM_PARAMETER(double, base_x_max, 12.0)
AIM_PARAMETER(double, base_y_min, -9.0)
AIM_PARAMETER(double, base_y_max, 9.0)
AIM_PARAMETER(double, base_z_min, 0.2)
AIM_PARAMETER(double, base_z_max, 3.0)
AIM_PARAMETER(double, fire_rate_hz, 15.0)
AIM_PARAMETER(double, projectile_speed, 22.0)
AIM_PARAMETER(double, projectile_diameter, 0.017)
AIM_PARAMETER(double, projectile_mass, 0.0032)
AIM_PARAMETER(int, projectile_pool_size, 128)
AIM_PARAMETER(double, projectile_lifetime, 8.0)
AIM_PARAMETER(double, projectile_hit_lifetime, 2.0)
AIM_PARAMETER(double, fire_command_timeout, 0.0)
AIM_PARAMETER(double, angle_command_timeout, 0.0)
AIM_PARAMETER(std::string, model_base_body, "base_link")
AIM_PARAMETER(std::string, model_yaw_body, "yaw_link")
AIM_PARAMETER(std::string, model_pitch_body, "pitch_link")
AIM_PARAMETER(std::string, model_camera_body, "camera_link")
AIM_PARAMETER(std::string, model_yaw_joint, "yaw_joint")
AIM_PARAMETER(std::string, model_pitch_joint, "pitch_joint")
AIM_PARAMETER(std::string, model_camera_name, "gimbal_camera")
AIM_PARAMETER(std::string, model_muzzle_site, "muzzle")
AIM_PARAMETER(std::string, frame_world, "world")
AIM_PARAMETER(std::string, frame_base, "base_link")
AIM_PARAMETER(std::string, frame_yaw, "yaw_link")
AIM_PARAMETER(std::string, frame_pitch, "pitch_link")
AIM_PARAMETER(std::string, frame_camera, "camera_link")
AIM_PARAMETER(std::string, frame_camera_optical, "camera_optical_frame")
AIM_PARAMETER(std::string, frame_muzzle, "muzzle_link")
AIM_PARAMETER(std::string, topic_image, "/camera/image_raw")
AIM_PARAMETER(std::string, topic_camera_info, "/camera/camera_info")
AIM_PARAMETER(std::string, topic_pitch_state, "/gimbal/pitch")
AIM_PARAMETER(std::string, topic_yaw_state, "/gimbal/yaw")
AIM_PARAMETER(std::string, topic_pitch_command, "/gimbal/target_pitch")
AIM_PARAMETER(std::string, topic_yaw_command, "/gimbal/target_yaw")
AIM_PARAMETER(std::string, topic_fire_command, "/gimbal/fire")
AIM_PARAMETER(std::string, topic_joint_states, "/joint_states")
AIM_PARAMETER(std::string, topic_clock, "/clock")
AIM_PARAMETER(std::string, topic_tf, "/tf")
AIM_PARAMETER(std::string, topic_tf_static, "/tf_static")
AIM_PARAMETER(std::string, topic_shot_count, "/sim/shot_count")
AIM_PARAMETER(std::string, topic_hit_event, "/sim/projectile_hit")
AIM_PARAMETER(std::string, topic_camera_fps, "/sim/camera_fps")

// Field is an upstream verified export produced by scripts/import_rmuc_field.py.
AIM_PARAMETER(std::string, field_xml, "")
AIM_PARAMETER(bool, target_enabled, true)
AIM_PARAMETER(double, target_x, 5.0)
AIM_PARAMETER(double, target_y, 0.0)
AIM_PARAMETER(double, target_z, 0.0)
AIM_PARAMETER(double, target_r1, 0.6)
AIM_PARAMETER(double, target_r2, 0.6)
AIM_PARAMETER(double, target_h1, 0.8)
AIM_PARAMETER(double, target_h2, 0.8)
AIM_PARAMETER(double, target_tilt_deg, 15.0)
AIM_PARAMETER(double, target_angular_speed, 0.0)
AIM_PARAMETER(double, target_initial_angle, 0.0)
AIM_PARAMETER(std::string, target_color, "red")
AIM_PARAMETER(bool, camera_use_intrinsics, false)
AIM_PARAMETER(double, camera_fx, 554.256258)
AIM_PARAMETER(double, camera_fy, 554.256258)
AIM_PARAMETER(double, camera_cx, 319.5)
AIM_PARAMETER(double, camera_cy, 239.5)
AIM_PARAMETER(double, lighting_brightness, 1.0)
AIM_PARAMETER(std::string, topic_hit_count, "/sim/armor_hit_count")
AIM_PARAMETER(std::string, topic_hit_rate, "/sim/armor_hit_rate")
AIM_PARAMETER(std::string, topic_statistics, "/sim/statistics")

// Dark background / bright lamp controls for binary-image detector testing.
AIM_PARAMETER(bool, dark_sky, false)
AIM_PARAMETER(double, environment_albedo, 1.0)
AIM_PARAMETER(double, target_light_whiteness, 0.0)
