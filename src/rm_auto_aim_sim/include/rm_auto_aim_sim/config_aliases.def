// Old YAML and ROS startup names remain accepted. Do not specify both names.
AIM_ALIAS(target_enabled, armor_enabled)
AIM_ALIAS(target_x, armor_x)
AIM_ALIAS(target_y, armor_y)
AIM_ALIAS(target_z, armor_z)
AIM_ALIAS(target_r1, armor_r1)
AIM_ALIAS(target_r2, armor_r2)
AIM_ALIAS(target_h1, armor_h1)
AIM_ALIAS(target_h2, armor_h2)
AIM_ALIAS(target_tilt_deg, armor_tilt_deg)
AIM_ALIAS(target_angular_speed, armor_angular_speed)
AIM_ALIAS(target_initial_angle, armor_initial_angle)
AIM_ALIAS(target_color, armor_color)
AIM_ALIAS(target_light_whiteness, armor_light_whiteness)
