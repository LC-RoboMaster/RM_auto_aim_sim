        <joint name="pitch_joint" type="hinge" axis="0 -1 0" limited="true" range="-0.523599 0.785398" damping="0.1"/>
        <geom type="box" size="0.18 0.10 0.055" mass="0.8" rgba="0.25 0.32 0.4 1" contype="0" conaffinity="0"/>
