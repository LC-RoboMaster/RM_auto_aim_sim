          <geom type="box" size="0.035 0.025 0.025" rgba="0.05 0.06 0.07 1" contype="0" conaffinity="0"/>
          <!-- MuJoCo camera: right = -Y; up = +Z; looks along local -Z = body +X. -->
          <camera name="gimbal_camera" pos="0.04 0 0" xyaxes="0 -1 0 0 0 1" fovy="60" ipd="0"/>
        </body>
      </body>
    </body>
  </body>
</mujoco>
