<?xml version="1.0"?>
<package format="3">
  <name>rm_auto_aim_sim</name>
  <version>0.1.0</version>
  <description>MuJoCo gimbal, RGB camera and projectile simulator for RoboMaster visual algorithms.</description>
  <maintainer email="maintainer@example.com">RM Auto Aim Simulator contributors</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend><depend>rcl_interfaces</depend>
  <depend>sensor_msgs</depend><depend>geometry_msgs</depend>
  <depend>rosgraph_msgs</depend><depend>std_msgs</depend><depend>tf2_msgs</depend>
  <depend>yaml-cpp</depend>
  <exec_depend>rclpy</exec_depend><exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
